# npm run voice 설정 — 이 파일을 복사해 .env 로 만들고 값을 채우세요.
# .env 는 깃(.gitignore)과 설치 파일(.exe)에 들어가지 않습니다. 키를 다른 곳에 붙여 넣지 마세요.

# ElevenLabs → Profile → API Keys (가능하면 Text to Speech 권한만)
ELEVENLABS_API_KEY=

# ElevenLabs → Voices → 내 복제 음성 → Voice ID
ELEVENLABS_VOICE_ID=

# 선택: 음성 설정 (비워 두면 기본값)
# 안정성 — 낮을수록 감정이 풍부하지만 들쭉날쭉 (0~1, 기본 0.5)
VOICE_STABILITY=
# 원래 목소리와 닮은 정도 (0~1, 기본 0.8)
VOICE_SIMILARITY=
# 말투 과장 (0~1, 기본 0)
VOICE_STYLE=

# 질문 시간의 AI 답변(Claude) — https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
